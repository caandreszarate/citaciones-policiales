{
  "name": "citaciones-policiales",
  "version": "1.0.0",
  "description": "Emision de formatos de citacion policial en blanco con codigo de registro unico y QR de consulta.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db.test.ts",
    "pdf:preview": "node --experimental-strip-types scripts/preview-pdf.mjs",
    "pdf:check": "node --experimental-strip-types scripts/check-pdf.mjs",
    "docx:check": "node --experimental-strip-types scripts/check-docx.mjs",
    "db:start": "./scripts/test-db.sh start",
    "db:stop": "./scripts/test-db.sh stop",
    "docx:template": "node scripts/build-docx-template.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
