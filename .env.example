# Copie este archivo a .env.local y rellene los valores del proyecto de Supabase.
# NUNCA ponga aqui la clave service_role: es privilegiada y no debe salir del servidor.

# Panel de Supabase > Project Settings > Data API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXXXXXX.supabase.co

# Clave "anon"/"publishable". Es publica por diseno: solo puede hacer lo que
# permiten las politicas RLS y los GRANT de las funciones.
VITE_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Base de la URL que se codifica en los QR impresos. Debe apuntar a la aplicacion
# publicada. Si se deja vacia se deduce de donde se sirve la aplicacion, pero
# conviene fijarla para que los QR ya impresos sigan siendo validos aunque cambie
# el dominio.
VITE_VERIFY_BASE_URL=https://caandreszarate.github.io/citaciones-policiales

# Subruta de GitHub Pages en la compilacion. En local no hace falta.
# VITE_BASE_PATH=/citaciones-policiales/
